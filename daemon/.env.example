# Environment Configuration for Vibe Audit

# LLM Configuration
# Examples: openai/gpt-5.2, openai/gpt-5-mini, openai/gpt-5-nano,
#           gemini/gemini-3-pro-preview, gemini/gemini-3-flash-preview,
#           gemini/gemini-2.5-pro, gemini/gemini-2.5-flash,
#           anthropic/claude-sonnet-4-5
LLM_MODEL=openai/gpt-5-nano

# API Keys (set at least one)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database
DATABASE_URL=sqlite:///./vibe_audit.db

# Server
HOST=0.0.0.0
PORT=8000
